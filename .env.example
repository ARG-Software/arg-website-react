# PRODUCTION REQUIRED

# AI-Assistant/RAG database
RAG_DATABASE_URL=https://your-chatbot-database-url
RAG_DATABASE_SERVICE_ROLE_KEY=your-chatbot-database-service-role-key
EMBEDDING_API_KEY=your-embedding-key
EMBEDDING_MODEL=your-embedding-model
FALLBACK_EMBEDDING_MODEL=your-fallback-embedding-model
AI_MODEL_API_KEY=your-ai-model-key
AI_MODEL=your-ai-model
ALTCHA_HMAC_KEY=generate-a-random-hex-key

# Admin
ADMIN_DATABASE_ANON_KEY=your-admin-database-anon-key
ADMIN_DATABASE_URL=https://your-admin-database-url
ADMIN_DATABASE_SERVICE_ROLE_KEY=your-admin-database-service-role-key
OUTREACH_ENCRYPTION_KEY_V1=generate-a-32-byte-base64-or-64-char-hex-key
OUTREACH_ENCRYPTION_KEY_ACTIVE_VERSION=1
OUTREACH_BLIND_INDEX_KEY=generate-a-random-hmac-secret
OUTREACH_AUDIT_SALT=generate-a-random-salt
ASSISTANT_CONVERSATION_ENCRYPTION_KEY_ACTIVE_VERSION=1
ASSISTANT_CONVERSATION_ENCRYPTION_KEY_V1=generate-a-32-byte-base64-or-64-char-hex-key
VISIT_BLIND_INDEX_KEY=generate-a-random-hmac-secret
VISIT_LOG_RATE_LIMIT_PER_MINUTE=30
VISIT_LOG_RATE_LIMIT_PER_DAY=2000
VISIT_LOG_GLOBAL_RATE_LIMIT_PER_DAY=50000
VISIT_LOG_RATE_LIMIT_SALT=arg-visit-log-rate-limit

# Frontend analytics provider: ga4, firstParty, both, or none
VITE_ANALYTICS_PROVIDER=both


# Not required in production - defaults shown
EMBEDDING_DIMENSIONS=your-embedding-dimensions
FALLBACK_EMBEDDING_DIMENSIONS=your-fallback-embedding-dimensions
EMBEDDING_REQUEST_DELAY_MS=your-embedding-request-delay-ms
RAG_SITE_URL=your-site-url
RAG_COMPANY_NAME=ARG Software
RAG_CHUNK_SIZE=your-chunk-size
RAG_CHUNK_OVERLAP=your-chunk-overlap
RAG_MATCH_COUNT=your-match-count
RAG_SIMILARITY_THRESHOLD=your-similarity-threshold
RAG_FALLBACK_SIMILARITY_THRESHOLD=your-fallback-similarity-threshold
RAG_ASK_RATE_LIMIT_PER_MINUTE=your-rate-limit-per-minute
RAG_ASK_RATE_LIMIT_PER_DAY=your-rate-limit-per-day
RAG_ASK_GLOBAL_RATE_LIMIT_PER_DAY=your-global-rate-limit-per-day
RAG_ASK_RATE_LIMIT_SALT=arg-ask-rate-limit
ALTCHA_COST=your-altcha-cost
ALTCHA_COUNTER_MIN=your-altcha-counter-min
ALTCHA_COUNTER_MAX=your-altcha-counter-max

## DEVELOPMENT ONLY - DO NOT USE IN PRODUCTION
ALLOWED_API_ORIGINS=http://localhost:8888,http://localhost:3000
MEDIUM_BROWSER_PATH=C:/Path/To/chrome.exe

## OPTIONAL CLI MIGRATION TOOLING ONLY
ADMIN_DATABASE_PROJECT_REF=your-admin-database-project-ref
ADMIN_DATABASE_ACCESS_TOKEN=your-admin-database-access-token
RAG_DATABASE_PROJECT_REF=your-rag-database-project-ref
RAG_DATABASE_ACCESS_TOKEN=your-rag-database-access-token
