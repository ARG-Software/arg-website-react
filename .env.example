DATABASE_URL=your-project-url
DATABASE_PROJECT_REF=your-project-ref
DATABASE_ACCESS_TOKEN=your-access-token
DATABASE_SERVICE_ROLE_KEY=your-service-role-key

EMBEDDING_API_KEY=your-embedding-key
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
FALLBACK_EMBEDDING_MODEL=gemini-embedding-001
FALLBACK_EMBEDDING_DIMENSIONS=768
EMBEDDING_REQUEST_DELAY_MS=750

AI_MODEL_API_KEY=your-ai-model-key
AI_MODEL=deepseek-v4-flash

RAG_FALLBACK_SIMILARITY_THRESHOLD=0.60

# Rate limiting (optional, defaults shown)
RAG_ASK_RATE_LIMIT_PER_MINUTE=6
RAG_ASK_RATE_LIMIT_PER_DAY=30
RAG_ASK_GLOBAL_RATE_LIMIT_PER_DAY=500
RAG_ASK_RATE_LIMIT_SALT=your-random-salt

# ALTCHA bot verification (required for ask endpoint)
ALTCHA_HMAC_KEY=generate-a-random-hex-key