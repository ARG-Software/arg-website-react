# Production required
DATABASE_URL=your-project-url
DATABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key
EMBEDDING_API_KEY=your-embedding-key
AI_MODEL_API_KEY=your-ai-model-key
ALTCHA_HMAC_KEY=generate-a-random-hex-key
RAG_ASK_RATE_LIMIT_SALT=your-random-salt
OUTREACH_ADMIN_EMAILS=jose@example.com,rui@example.com
OUTREACH_ENCRYPTION_KEY_ACTIVE_VERSION=1
OUTREACH_ENCRYPTION_KEY_V1=generate-a-32-byte-base64-or-64-char-hex-key
OUTREACH_AUDIT_SALT=generate-a-random-salt

# Production optional - defaults shown
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIMENSIONS=your-embedding-dimensions
FALLBACK_EMBEDDING_MODEL=your-fallback-embedding-model
FALLBACK_EMBEDDING_DIMENSIONS=your-fallback-embedding-dimensions
EMBEDDING_REQUEST_DELAY_MS=your-request-delay-ms
AI_MODEL=your-ai-model
RAG_SITE_URL=your-site-url
RAG_COMPANY_NAME=ARG Software
RAG_CHUNK_SIZE=your-chunk-size
RAG_CHUNK_OVERLAP=your-chunk-overlap
RAG_MATCH_COUNT=your-match-count
RAG_SIMILARITY_THRESHOLD=your-similarity-threshold
RAG_FALLBACK_SIMILARITY_THRESHOLD=your-fallback-similarity-threshold
RAG_ASK_RATE_LIMIT_PER_MINUTE=your-minute-rate-limit
RAG_ASK_RATE_LIMIT_PER_DAY=your-daily-rate-limit
RAG_ASK_GLOBAL_RATE_LIMIT_PER_DAY=your-global-rate-limit
ALTCHA_COST=your-cost-value
ALTCHA_COUNTER_MIN=your-counter-min-value
ALTCHA_COUNTER_MAX=your-counter-max-value

# Not needed in production - local tooling only
DATABASE_PROJECT_REF=your-project-ref
DATABASE_ACCESS_TOKEN=your-access-token
MEDIUM_BROWSER_PATH=C:/Path/To/chrome.exe
