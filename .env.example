# PRODUCTION REQUIRED

# AI-Assistant/RAG database
DATABASE_URL=https://your-chatbot-database-url
DATABASE_SERVICE_ROLE_KEY=your-chatbot-database-service-role-key
EMBEDDING_API_KEY=your-embedding-key
EMBEDDING_MODEL=your-embedding-model
FALLBACK_EMBEDDING_MODEL=your-fallback-embedding-model
AI_MODEL_API_KEY=your-ai-model-key
AI_MODEL=your-ai-model
ALTCHA_HMAC_KEY=generate-a-random-hex-key

# Admin/outreach
VITE_ADMIN_DATABASE_URL=https://your-admin-database-url
VITE_ADMIN_DATABASE_ANON_KEY=your-admin-database-anon-key
ADMIN_DATABASE_URL=https://your-admin-database-url
ADMIN_DATABASE_SERVICE_ROLE_KEY=your-admin-database-service-role-key
OUTREACH_ENCRYPTION_KEY_V1=generate-a-32-byte-base64-or-64-char-hex-key
OUTREACH_ENCRYPTION_KEY_ACTIVE_VERSION=1
OUTREACH_BLIND_INDEX_KEY=generate-a-random-hmac-secret
OUTREACH_AUDIT_SALT=generate-a-random-salt


# Not required in production - defaults shown
EMBEDDING_DIMENSIONS=768
FALLBACK_EMBEDDING_DIMENSIONS=768
EMBEDDING_REQUEST_DELAY_MS=750
RAG_SITE_URL=https://arg.software
RAG_COMPANY_NAME=ARG Software
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180
RAG_MATCH_COUNT=6
RAG_SIMILARITY_THRESHOLD=0.72
RAG_FALLBACK_SIMILARITY_THRESHOLD=0.60
RAG_ASK_RATE_LIMIT_PER_MINUTE=6
RAG_ASK_RATE_LIMIT_PER_DAY=30
RAG_ASK_GLOBAL_RATE_LIMIT_PER_DAY=500
RAG_ASK_RATE_LIMIT_SALT=arg-ask-rate-limit
ALTCHA_COST=2000
ALTCHA_COUNTER_MIN=1000
ALTCHA_COUNTER_MAX=3000

## DEVELOPMENT ONLY - DO NOT USE IN PRODUCTION
ALLOWED_API_ORIGINS=http://localhost:8888,http://localhost:3000
MEDIUM_BROWSER_PATH=C:/Path/To/chrome.exe

## OPTIONAL CLI MIGRATION TOOLING ONLY
ADMIN_DATABASE_PROJECT_REF=your-admin-database-project-ref
ADMIN_DATABASE_ACCESS_TOKEN=your-admin-database-access-token
RAG_DATABASE_PROJECT_REF=your-rag-database-project-ref
RAG_DATABASE_ACCESS_TOKEN=your-rag-database-access-token
