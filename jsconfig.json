{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "target": "ES2022",
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "paths": {
      "@components/*": ["./src/frontend/components/*"],
      "@hooks/*": ["./src/frontend/hooks/*"],
      "@constants/*": ["./src/frontend/constants/*"],
      "@providers/*": ["./src/frontend/providers/*"],
      "@utils/*": ["./src/frontend/utils/*"],
      "@services/*": ["./src/frontend/services/*"],
      "@data/*": ["./src/frontend/data/*"],
      "@styles/*": ["./src/frontend/styles/*"],
      "@ui/*": ["./src/packages/ui/src/*"],
      "@backend/*": ["./src/backend/*"],
      "@backend-rag/*": ["./src/backend/rag/*"],
      "@backend-admin/*": ["./src/backend/admin/*"],
      "@backend-shared/*": ["./src/backend/shared/*"]
    }
  },
  "include": ["src/**/*", "vite.config.js", "plugins/**/*"]
}
