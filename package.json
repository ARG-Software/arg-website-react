{
  "name": "arg-software-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "altcha": "^3.2.1",
    "altcha-lib": "^2.3.1",
    "gsap": "^3.14.2",
    "highlight.js": "^11.11.1",
    "lenis": "^1.3.18",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.17.0",
    "three": "^0.183.2"
  },
  "scripts": {
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "build": "npm run check:file-casing && npm run lint:fix && vite build",
    "preview": "vite preview",
    "lint": "npm run lint:all",
    "lint:app": "eslint src/frontend src/packages/ui --ext .js,.jsx --cache",
    "lint:backend": "eslint src/backend --ext .js --cache",
    "lint:all": "npm run check:file-casing && npm run lint:app && npm run lint:backend && npm run lint:rag",
    "lint:fix": "npm run lint:app:fix && npm run lint:backend:fix && npm run lint:rag:fix",
    "lint:app:fix": "eslint src/frontend src/packages/ui --ext .js,.jsx --fix",
    "lint:backend:fix": "eslint src/backend --ext .js --fix",
    "typecheck:rag": "tsc --project tsconfig.rag.json",
    "check:file-casing": "node scripts/check-file-casing.cjs",
    "blog:import:medium": "node scripts/import-medium-articles.cjs",
    "blog:import:medium:drafts": "node scripts/import-medium-articles.cjs --drafts",
    "outreach:import": "node scripts/import-outreach.js \"external/arg-outreach (1).xlsx\"",
    "outreach:import:dry-run": "node scripts/import-outreach.js \"external/arg-outreach (1).xlsx\" --dry-run",
    "admin:bootstrap": "node scripts/bootstrap-admin-users.js",
    "sync:blog": "npm run blog:import:medium && npm run rag:ingest:local -- --all",
    "rag:ingest:local": "tsx src/backend/rag/scripts/ingestLocal.ts",
    "rag:ingest:external": "tsx src/backend/rag/scripts/ingestExternal.ts",
    "rag:embeddings:rebuild:fallback": "tsx src/backend/rag/scripts/rebuildFallbackEmbeddings.ts",
    "rag:ask": "tsx src/backend/rag/scripts/ask.ts",
    "rag:test": "tsx --test --test-concurrency=1 \"src/backend/rag/tests/**/*.test.ts\"",
    "test:backend": "node --test --test-concurrency=1 \"src/backend/**/*.test.js\"",
    "database:admin:push": "node supabase/scripts.js admin push",
    "database:rag:push": "node supabase/scripts.js rag push"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@storybook/react-vite": "^10.5.7",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-react": "^5.2.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.61.1",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "storybook": "^10.5.7",
    "svgo": "^4.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.5",
    "vite-plugin-image-optimizer": "^2.0.3",
    "xlsx": "^0.18.5"
  }
}
