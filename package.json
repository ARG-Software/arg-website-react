{
  "name": "arg-software-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "gsap": "^3.14.2",
    "highlight.js": "^11.11.1",
    "lenis": "^1.3.18",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.17.0",
    "three": "^0.183.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run lint:fix && vite build",
    "preview": "vite preview",
    "lint": "eslint src plugins rag supabase/scripts.js netlify/functions --ext .js,.jsx,.ts",
    "lint:fix": "eslint src plugins rag supabase/scripts.js netlify/functions --ext .js,.jsx,.ts --fix",
    "typecheck:rag": "tsc --project tsconfig.rag.json",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "blog:import:medium": "node scripts/import-medium-articles.cjs",
    "blog:import:medium:drafts": "node scripts/import-medium-articles.cjs --drafts",
    "rag:ingest:internal": "tsx rag/ingestion/scripts/ingestInternal.ts",
    "rag:ingest:external": "tsx rag/ingestion/scripts/ingestExternal.ts",
    "rag:ask:test": "tsx rag/runtime/scripts/testAsk.ts",
    "supabase:link": "node supabase/scripts.js link",
    "supabase:push": "node supabase/scripts.js push"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-react": "^5.2.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.61.1",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.5",
    "vite-plugin-image-optimizer": "^2.0.3"
  }
}
